{
  "name": "disrupting-alpha-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "design:lint": "designmd lint ../DESIGN.md",
    "design:export": "designmd export --format json-tailwind ../DESIGN.md > src/design-tokens.json",
    "dev": "npm run design:export && vite",
    "build": "npm run design:export && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "axios": "^1.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^1.6.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.13.2",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@google/design.md": "^0.3.0",
    "@netlify/functions": "^2.8.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^24.0.0",
    "netlify-cli": "^17.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
