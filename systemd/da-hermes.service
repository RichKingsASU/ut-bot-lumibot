[Unit]
Description=Disrupting Alpha - Hermes Observer Layer
Documentation=file:///home/k2/ut-bot-lumibot/scripts/systemd/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionFileNotEmpty=/etc/systemd/system/da-doppler.conf

[Service]
Type=simple
User=k2
Group=k2
WorkingDirectory=/home/k2/ut-bot-lumibot
EnvironmentFile=/etc/systemd/system/da-doppler.conf
ExecStart=doppler run \
  --token ${DOPPLER_TOKEN} \
  --project disrupting-alpha \
  --config prd \
  -- /home/k2/ut-bot-lumibot/venv/bin/python hermes/main.py
Restart=always
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=300
TimeoutStopSec=30
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=da-hermes

[Install]
WantedBy=multi-user.target
