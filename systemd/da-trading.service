[Unit]
Description=Disrupting Alpha - UT Bot Options Trading Bot
Documentation=file:///home/k2/ut-bot-lumibot/scripts/systemd/README.md
After=network-online.target
Wants=network-online.target
ConditionFileNotEmpty=/etc/systemd/system/da-doppler.conf

# Start limit zero ensures infinite retries if the app crashes, 
# relying on watchdog to alert humans if it's flapping.
StartLimitIntervalSec=0

[Service]
Type=simple
User=k2
Group=k2
WorkingDirectory=/home/k2/ut-bot-lumibot
EnvironmentFile=/etc/systemd/system/da-doppler.conf

# Execute the new, simplified broker-authoritative executor
ExecStart=doppler run \
  --token ${DOPPLER_TOKEN} \
  --project disrupting-alpha \
  --config prd \
  -- /home/k2/ut-bot-lumibot/venv/bin/python src/trading/executor.py

Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=da-trading-bot

[Install]
WantedBy=multi-user.target
